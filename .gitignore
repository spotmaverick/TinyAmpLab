# 数据与权重不入库（体积大）
sync/data/
sync/weights/
sync/results/logs/
dataset_zenodo/*.zip
dataset_zenodo/*.z0*
# 分段下载缓存（断点续传中间产物，单文件可达百 MB 级，绝不入库）
dataset_zenodo/*.parts/
dataset_zenodo/ua_extract/
dataset_zenodo/marshall_extract/
dataset_zenodo/tmp*
dataset_zenodo/check_md5.py
dataset_zenodo/bad_files.json
github_mirrors/
*.wav
*.pt
*.nam
*.npy
# 私有 Python 运行环境（1.3G，按机器重建，绝不入库）
.venv_nam/
# 集群回传的打包件：内容与解包目录重复，只保留解包后的文本产物
reclaimed/**/*.tgz
*.tgz
# 训练检查点与 TensorBoard 事件流（二进制，体积大，可由 runs/ 配置重训复现）
*.ckpt
reclaimed/**/checkpoints/
**/events.out.tfevents.*
__pycache__/
*.pyc
*.log
.DS_Store
.ipynb_checkpoints/
# Agent 工具的本地记忆/状态，非项目资产（有价值的内容已蒸馏进 docs/reports/）
.workbuddy/
dcu_runs/.synced/ .state/
