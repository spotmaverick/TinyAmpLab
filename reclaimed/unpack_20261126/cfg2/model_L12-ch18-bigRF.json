{
    "_notes": [
        "L10-bigRF 是当前器件冠军（器件 NRMS 0.2785, ratio 3.50），但数字精度 0.0796",
        "不及族 A 的 15 层配置（0.0574）。本批目标：在保持 L10 的前提下提升数字容量。",
        "手段：加宽通道 ch18->ch24/32，或加层到 12。物理成本：交叉开关 ch^2/g 上升，",
        "但延迟线抽头数仍少于 15 层。",
        "12 层 ch18 g6：层数与容量折中"
    ],
    "net": {
        "name": "WaveNet",
        "config": {
            "layers_configs": [
                {
                    "condition_size": 1,
                    "input_size": 1,
                    "channels": 18,
                    "head": {
                        "out_channels": 1,
                        "kernel_size": 1,
                        "bias": true
                    },
                    "kernel_size": 6,
                    "dilations": [
                        1,
                        7,
                        47,
                        157,
                        329,
                        613,
                        1,
                        7,
                        47,
                        157,
                        329,
                        613
                    ],
                    "activation": "LeakyReLU",
                    "groups_input": 6
                }
            ],
            "head_scale": 0.01
        }
    },
    "optimizer": {
        "lr": 0.004
    },
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.993
        }
    }
}