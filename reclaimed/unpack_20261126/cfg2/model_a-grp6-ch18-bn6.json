{
    "_notes": [
        "a-grp6-ch18 + bottleneck 6：1x1 层宽度 18->6，交叉开关 9732->约 4100",
        "目的：抑制残差流幅度增长（模拟电路摆幅需求），同时降成本"
    ],
    "net": {
        "name": "WaveNet",
        "config": {
            "layers_configs": [
                {
                    "condition_size": 1,
                    "input_size": 1,
                    "channels": 18,
                    "head": {
                        "out_channels": 1,
                        "kernel_size": 1,
                        "bias": true
                    },
                    "kernel_size": 6,
                    "dilations": [
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227
                    ],
                    "activation": "LeakyReLU",
                    "groups_input": 6,
                    "bottleneck": 6
                }
            ],
            "head_scale": 0.01
        }
    },
    "optimizer": {
        "lr": 0.004
    },
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.993
        }
    }
}
