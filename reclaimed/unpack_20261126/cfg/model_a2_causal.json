{
    "_notes": [
        "官方 wavenet_slimmable 架构，唯一改动：init_strategy 由 smallest_and_zeros 改为 channel_causal",
        "原因：smallest_and_zeros 会把大通道权重+bias 全清零，且 input_mixer 无 bias，",
        "导致大通道输入恒为 0 -> 权重梯度恒为 0 -> 12ch 分支永久死锁（实测 ratio>=0.5 总梯度严格为 0）"
    ],
    "net": {
        "name": "WaveNet",
        "config": {
            "layers_configs": [
                {
                    "condition_size": 1,
                    "input_size": 1,
                    "channels": 12,
                    "head": {
                        "out_channels": 1,
                        "kernel_size": 1,
                        "bias": true
                    },
                    "kernel_size": 6,
                    "dilations": [
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227
                    ],
                    "activation": "LeakyReLU",
                    "slimmable": {
                        "method": "slice_channels_uniform",
                        "kwargs": {
                            "allowed_channels": [
                                3,
                                12
                            ],
                            "boosting": true,
                            "init_strategy": "channel_causal"
                        }
                    }
                }
            ],
            "head_scale": 0.01
        }
    },
    "optimizer": {
        "lr": 0.004
    },
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.993
        }
    }
}
