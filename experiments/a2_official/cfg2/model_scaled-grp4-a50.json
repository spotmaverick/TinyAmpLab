{
    "_notes": [
        "模拟原生残差缩放：每层 layer1x1 输出乘 alpha=0.5",
        "动机：器件仿真实测 a-grp4 残差流从 0.047 涨到 22.6 RMS（480x），",
        "导致 Gilbert cell 饱和、精度退化 44.7x，V_SAT 需 64~128。",
        "alpha<1 在模拟电路里只是电阻分压比，零成本，但能压住幅度增长。",
        "必须重训（直接缩放已训权重会崩到 NRMS 0.81）。"
    ],
    "net": {
        "name": "ScaledWaveNet",
        "config": {
            "layers_configs": [
                {
                    "condition_size": 1,
                    "input_size": 1,
                    "channels": 12,
                    "head": {
                        "out_channels": 1,
                        "kernel_size": 1,
                        "bias": true
                    },
                    "kernel_size": 6,
                    "dilations": [
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227,
                        1,
                        5,
                        29,
                        97,
                        227
                    ],
                    "activation": "LeakyReLU",
                    "groups_input": 4
                }
            ],
            "head_scale": 0.01,
            "residual_scale": 0.5
        }
    },
    "optimizer": {
        "lr": 0.004
    },
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.993
        }
    }
}
